# ShuttleX API Configuration
# Copy this file to .env and fill in your values

# Geliştirme: http://localhost:4000
# Vercel (prod): boş bırakın (relative URL /api/... kullanılır)
VITE_API_URL=http://localhost:4000
VITE_CHAT_URL=
VITE_API_KEY=
VITE_AUTH_TOKEN=
VITE_TENANT_ID=t-1001

# Navigation — Google Maps (opsiyonel, Leaflet/OSM ücretsiz çalışır)
# Google Cloud Console → APIs & Services → Credentials → API Keys
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_MAP_ID=

# Gemini AI API Key (opsiyonel)
VITE_GEMINI_API_KEY=
