{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd web-dashboard && npm install && cd ../api && npm install",
  "builds": [
    {
      "src": "web-dashboard/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.ts" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
